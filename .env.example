# Base de datos.
# Supabase → botón "Connect" → Connection string → "Session pooler" (IPv4, puerto 5432; sirve en Vercel).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opcional para migraciones: URL directa o Session pooler (5432).
# Si está vacío se usa DATABASE_URL. No necesita anon key ni service_role key.
MIGRATION_DATABASE_URL=

# Mientras no haya Supabase: `npm run db:local` y usa esta en su lugar.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Opcional: conexiones simultáneas a Postgres (por defecto 5; 1 en local).
# DATABASE_POOL_MAX=5

# Opcional: clave PRIVADA de Vapi para consultar metadatos de llamadas desde el servidor.
# No usar NEXT_PUBLIC_, no distribuir a la APK ni guardar su valor en Git.
VAPI_PRIVATE_KEY=

# Inferencia del agente privado Maritime; solo el servidor web usa esta credencial.
# El modelo y la clave del proxy LLM permanecen dentro de la VM Maritime.
MARITIME_REPORT_AGENT_ID=
MARITIME_REPORT_API_KEY=
TISKZ_REPORT_MODEL=gpt-4.1-mini
# Habilitar solo en el entorno de pruebas ficticias del equipo.
TISKZ_DEMO_REPORTS_ENABLED=false

# Enlace público del APK para el botón de la portada (p. ej. un GitHub Release). Vacío = "APK disponible pronto".
APK_URL=

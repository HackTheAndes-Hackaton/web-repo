# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Opcional: análisis con Claude. Sin esta clave se usan las reglas locales.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# ANALYSIS_MODE=reglas   # o "claude" para forzarlo
